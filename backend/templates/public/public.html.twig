{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ vite_entry_link_tags('public') }}
{% endblock stylesheets %}

{% block title %}{{ parent() }} - {{ title }}{% endblock %}

{% block main %}
    <div id="react-app"></div>
{% endblock main %}

{% block javascripts %}
    {# Jetons CSRF de la SPA (test d'éligibilité + inscription/connexion), générés une fois pour toutes au premier
   chargement — même mécanisme que brisPorte/creation_de_compte.html.twig. #}
    <script id="react-arguments" type="application/json">
      {{ react|default({})|json_encode()|raw }}
    </script>
    {% if est_vite_server_actif() %}
        {% include '_vite_hmr_extra.html.twig' %}
    {% endif %}

    {{ vite_entry_script_tags('public') }}
{% endblock javascripts %}
